{"fileName":"OpenDeta Admin Panel !","codeType":"HTML","content":"<!DOCTYPE html>\n<html lang=\"bn\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>OpenDeta Admin Panel</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <script src=\"https://unpkg.com/@supabase/supabase-js@2\"></script>\n    <style>\n        body { background-color: #f1f5f9; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }\n        .grad-text {\n            background: linear-gradient(90deg, #10b981, #3b82f6);\n            -webkit-background-clip: text;\n            -webkit-text-fill-color: transparent;\n        }\n        /* Progress Bar Animation */\n        .progress-bar {\n            width: 100%;\n            height: 4px;\n            background-color: #e2e8f0;\n            border-radius: 4px;\n            overflow: hidden;\n            position: relative;\n        }\n        .progress-bar::before {\n            content: '';\n            position: absolute;\n            left: -50%;\n            width: 50%;\n            height: 100%;\n            background: linear-gradient(90deg, #10b981, #3b82f6);\n            animation: loading 1.5s infinite ease-in-out;\n        }\n        @keyframes loading {\n            0% { left: -50%; }\n            100% { left: 100%; }\n        }\n    </style>\n</head>\n<body class=\"text-slate-800 min-h-screen\">\n\n    <!-- [১] Password Screen (লগইন) -->\n    <div id=\"loginScreen\" class=\"fixed inset-0 bg-slate-900 z-50 flex items-center justify-center p-4\">\n        <div class=\"bg-white p-8 rounded-[2rem] max-w-sm w-full text-center shadow-2xl\">\n            <h2 class=\"text-2xl font-black text-slate-800 mb-2\">Admin Access</h2>\n            <p class=\"text-xs text-slate-500 mb-6\">Enter master password to continue</p>\n            <input type=\"password\" id=\"adminPass\" class=\"w-full bg-slate-50 border border-slate-200 p-4 rounded-xl text-center outline-none focus:border-emerald-400 mb-4\" placeholder=\"••••••••\">\n            <button onclick=\"checkAuth()\" class=\"w-full bg-emerald-500 text-white font-bold py-3 rounded-xl hover:bg-emerald-600 transition shadow-lg shadow-emerald-200\">Unlock Panel 🔐</button>\n        </div>\n    </div>\n\n    <!-- [২] Admin Content Screen (লগইন করার পর দেখাবে) -->\n    <div id=\"adminContent\" class=\"hidden max-w-4xl mx-auto p-6\">\n        \n        <!-- Header -->\n        <div class=\"flex flex-col md:flex-row justify-between items-center mt-6 mb-8 gap-4\">\n            <h1 class=\"text-3xl font-black grad-text\">OpenDeta Admin Panel</h1>\n            <button onclick=\"fetchData()\" class=\"bg-white border border-slate-200 text-slate-600 px-5 py-2 rounded-full text-sm font-bold shadow-sm hover:border-emerald-400 hover:text-emerald-500 transition\">\n                Refresh 🔄\n            </button>\n        </div>\n\n        <!-- Loading / Progress Bar -->\n        <div id=\"loader\" class=\"bg-white p-6 rounded-2xl shadow-sm border border-slate-100 mb-6 text-center\">\n            <p class=\"text-sm font-bold text-slate-500 mb-3 animate-pulse\">Checking for New Feedback…</p>\n            <div class=\"progress-bar\"></div>\n        </div>\n\n        <!-- Feedback Container -->\n        <div id=\"feedbackList\" class=\"space-y-6\">\n            <!-- ডেটাগুলো এখানে লোড হবে -->\n        </div>\n\n    </div>\n\n    <script>\n        // Supabase Config\n        const SB_URL = 'https://gdqbohxcszudvvlxjyyl.supabase.co';\n        const SB_KEY = 'sb_publishable_9IRRSJdSmBbtussatWiAyA_ShSe3m7x';\n        const MASTER_PASS = \"Wz@jQ_n@Ef2qJyA\"; // আপনার পাসওয়ার্ড\n        const sb = supabase.createClient(SB_URL, SB_KEY);\n\n        // সময় ও তারিখ ফরম্যাট (01/05/2026 04:45 PM)\n        function formatDateTime(dateString) {\n            const d = new Date(dateString);\n            const pad = (n) => n.toString().padStart(2, '0');\n            \n            const day = pad(d.getDate());\n            const month = pad(d.getMonth() + 1);\n            const year = d.getFullYear();\n            \n            let hours = d.getHours();\n            const minutes = pad(d.getMinutes());\n            const ampm = hours >= 12 ? 'PM' : 'AM';\n            \n            hours = hours % 12;\n            hours = hours ? hours : 12; // 0 হলে 12 হবে\n            const formattedHours = pad(hours);\n            \n            return `${day}/${month}/${year} ${formattedHours}:${minutes} ${ampm}`;\n        }\n\n        // লগইন চেক\n        function checkAuth() {\n            const pass = document.getElementById('adminPass').value;\n            if (pass === MASTER_PASS) {\n                document.getElementById('loginScreen').classList.add('hidden');\n                document.getElementById('adminContent').classList.remove('hidden');\n                fetchData();\n            } else {\n                alert(\"Incorrect Password! ❌\");\n            }\n        }\n\n        // ডেটা লোড করা\n        async function fetchData() {\n            const loader = document.getElementById('loader');\n            const list = document.getElementById('feedbackList');\n            \n            loader.style.display = 'block'; // লোডার চালু\n            list.innerHTML = \"\"; // আগের ডেটা মুছে ফেলা\n\n            // ডেটাবেস থেকে কল করা (নতুনটা সবার আগে)\n            const { data, error } = await sb.from('reports').select('*').order('id', { ascending: false });\n\n            loader.style.display = 'none'; // ডেটা আসলে লোডার বন্ধ\n\n            if (error) {\n                list.innerHTML = `<p class=\"text-red-500 text-center\">Error fetching data: ${error.message}</p>`;\n                return;\n            }\n\n            if (data.length === 0) {\n                list.innerHTML = `<div class=\"text-center py-10 bg-white rounded-3xl border border-slate-100\"><p class=\"text-slate-400 font-bold\">No feedback received yet.</p></div>`;\n                return;\n            }\n\n            data.forEach(item => {\n                // ছবি থাকলে তার জন্য HTML তৈরি\n                let imageHtml = '';\n                if (item.file_url) {\n                    const urls = item.file_url.split(', '); // কমা দিয়ে আলাদা করা ইউআরএলগুলো\n                    imageHtml = `<div class=\"mt-4 flex flex-wrap gap-2\">`;\n                    urls.forEach(url => {\n                        if(url) {\n                            // ছবিতে ক্লিক করলে নতুন ট্যাবে বড় করে খুলবে\n                            imageHtml += `<img src=\"${url}\" onclick=\"window.open('${url}', '_blank')\" class=\"w-20 h-20 md:w-24 md:h-24 object-cover rounded-xl border border-slate-200 cursor-pointer hover:opacity-80 transition shadow-sm\">`;\n                        }\n                    });\n                    imageHtml += `</div>`;\n                }\n\n                // কার্ড তৈরি\n                list.innerHTML += `\n                    <div class=\"bg-white p-6 md:p-8 rounded-[2rem] shadow-sm border border-slate-100 relative group transition-all hover:shadow-md\">\n                        \n                        <!-- Delete Button (Card-এর উপরে ডানে) -->\n                        <button onclick=\"deleteFeedback(${item.id})\" class=\"absolute top-6 right-6 bg-red-100 text-red-600 px-3 py-1.5 rounded-lg text-xs font-bold hover:bg-red-500 hover:text-white transition flex items-center gap-1\">\n                            Delete 🗑️\n                        </button>\n\n                        <!-- ১. অ্যাপের নাম -->\n                        <h3 class=\"text-lg font-bold text-emerald-600 mb-2 pr-20\">${item.name}</h3>\n                        \n                        <!-- ২. মূল মেসেজ -->\n                        <p class=\"text-slate-600 text-sm leading-relaxed whitespace-pre-wrap bg-slate-50 p-4 rounded-xl border border-slate-100\">${item.message}</p>\n                        \n                        <!-- ৩. স্ক্রিনশট (যদি থাকে) -->\n                        ${imageHtml}\n                        \n                        <!-- ৪. সময় ও তারিখ -->\n                        <div class=\"mt-6 pt-4 border-t border-slate-100 flex items-center text-[11px] font-bold text-slate-400\">\n                            🕒 ${formatDateTime(item.created_at)}\n                        </div>\n                    </div>\n                `;\n            });\n        }\n\n        // ডিলিট ফাংশন (Dialogue সহ)\n        async function deleteFeedback(id) {\n            const isConfirm = confirm(\"Are you sure you want to permanently delete this feedback?\\n\\n(Once deleted, it cannot be recovered!)\");\n            \n            if (isConfirm) {\n                const loader = document.getElementById('loader');\n                loader.style.display = 'block'; // ডিলিটের সময় লোডার দেখানো\n                document.querySelector('#loader p').innerText = \"Deleting Feedback...\";\n\n                const { error } = await sb.from('reports').delete().eq('id', id);\n                \n                if (!error) {\n                    fetchData(); // ডিলিট হলে আবার ডেটা লোড করবে\n                } else {\n                    alert(\"Error deleting feedback: \" + error.message);\n                    loader.style.display = 'none';\n                }\n            }\n        }\n    </script>\n</body>\n</html>"}